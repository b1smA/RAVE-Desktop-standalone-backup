{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAVE",
  "mainBinaryName": "rave-music-player",
  "version": "1.49.2",
  "identifier": "com.raveplayer.Rave",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "cd ../.. && pnpm --filter @nuclearplayer/player build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "RAVE",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http: https: ws: wss:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "Open music player with replaceable sources",
    "longDescription": "RAVE is an open-source fork of Nuclear, a desktop music player with plugins, themes, and replaceable music sources.",
    "copyright": "Copyright 2025-2026 nukeop; RAVE modifications 2026",
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
